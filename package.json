{
  "name": "stack-notes",
  "version": "0.1.0",
  "private": true,
  "description": "Stack Notes: notas técnicas en Markdown publicadas en GitHub Pages",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "editar": "node server/editor.js",
    "build": "vite build && node scripts/generar-datos.js",
    "previsualizar": "npm run build && vite preview",
    "publicar": "node scripts/publicar.js",
    "migrar": "node scripts/migrar-respaldo.js",
    "test": "node --test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "express": "^5.3.0",
    "vite": "^8.3.5"
  }
}
